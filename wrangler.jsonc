{
  // Cloudflare Workers + Static Assets configuration matching project name "la"
  "name": "la",
  "main": "./worker.ts",
  "compatibility_date": "2025-02-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
